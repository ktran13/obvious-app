# Copy to .env.local and adjust as needed. No real secrets belong in this file.

# Local Postgres started by `docker compose up` (see docker-compose.yml).
DATABASE_URL=postgresql://nyc_app:nyc_app@localhost:5432/nyc_app

# DEV ONLY — mock Google provider. Signs in a fixed dev user with no external
# calls, and only works outside production. Never set this in a deployed
# environment. For real Google OAuth, unset this and set GOOGLE_CLIENT_ID /
# GOOGLE_CLIENT_SECRET instead.
AUTH_DEV_MOCK=true

# Random string used to sign Auth.js session JWTs (openssl rand -base64 32).
# Dev convenience only — set a real value wherever the app is deployed.
AUTH_SECRET=replace-me
